{
  "manifest_version": 3,
  "name": "Quản lý vốn",
  "description": "Tính giá vốn trung bình và lãi/lỗ các coin Binance Spot từ lịch sử lệnh. Dữ liệu lưu trên máy.",
  "version": "0.1.0",
  "action": { "default_title": "Mở Quản lý vốn" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://api.binance.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
